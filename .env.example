# ─── Base de données ───────────────────────────────────────────
DATABASE_URL="postgresql://canari:canari@localhost:5432/canari?schema=public"
# Base dédiée aux tests d'intégration (vidée à chaque exécution)
TEST_DATABASE_URL="postgresql://canari:canari@localhost:5432/canari_test?schema=public"

# ─── Application ───────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Secret de signature des cookies/jetons internes (32+ caractères aléatoires)
SESSION_SECRET="change-me-with-openssl-rand-base64-48"

# ─── Paiements ─────────────────────────────────────────────────
# Prestataire actif : "mock" en développement. Les adaptateurs réels
# (CinetPay, Wave, Orange Money…) implémentent PaymentProvider.
PAYMENT_PROVIDER="mock"
# Secret HMAC partagé avec le prestataire pour signer les webhooks
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# ─── Tâches planifiées ────────────────────────────────────────
# Jeton attendu par /api/v1/jobs/* (en-tête Authorization: Bearer …)
CRON_SECRET="change-me-cron-secret"

# ─── Infrastructure optionnelle ───────────────────────────────
# Redis (limitation de débit distribuée, files). Vide = mémoire locale.
REDIS_URL=""
# Stockage S3-compatible pour les documents KYB (jamais public)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Notifications (adaptateurs) ──────────────────────────────
# Vide = les messages SMS/WhatsApp/e-mail sont journalisés et non envoyés.
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
